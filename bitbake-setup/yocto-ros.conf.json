{
    "version": "1.0",
    "description": "CU AESD Yocto Raspberry Pi ROS2 Image",
    "sources": {
        "bitbake": {
            "git-remote": {
                "uri": "https://git.openembedded.org/bitbake",
                "branch": "2.18",
                "rev": "2.18"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "uri": "https://git.openembedded.org/openembedded-core",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-yocto": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-yocto",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-openembedded": {
            "git-remote": {
                "uri": "https://git.openembedded.org/meta-openembedded",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
	"meta-raspberrypi": {
	    "git-remote": {
		"uri": "https://git.yoctoproject.org/meta-raspberrypi",
		"branch": "wrynose",
		"rev": "wrynose"
	    }
	},
	"meta-ros": {
	     "git-remote": {
		"uri": "https://github.com/ros/meta-ros.git",
		"branch": "wrynose",
		"rev": "wrynose"
	     }
	}
    },
    "bitbake-setup": {
        "configurations": [
            {
                "name": "yocto-final-project",
                "description": "CU AESD Yocto Final Project",
                "setup-dir-name": "yocto-final-project-wrynose",
                "top-dir-name": "build",
                "bb-layers": [
                    "openembedded-core/meta",
                    "meta-yocto/meta-poky",
                    "meta-yocto/meta-yocto-bsp",
		            "meta-openembedded/meta-oe",
		            "meta-openembedded/meta-python",
		            "meta-openembedded/meta-networking",
		            "meta-raspberrypi",
		            "meta-ros/meta-ros-common",
		            "meta-ros/meta-ros2",
		            "meta-ros/meta-ros2-lyrical"
                ],
                "bb-layers-file-relative": [
                    "../meta-aesd",
                    "../meta-lidar"
                ],
                "oe-fragments": [
		            "machine/raspberrypi4-64",
                    "distro/poky",
                    "meta-aesd/rm-work",
                    "meta-lidar/rpi-uart",
                    "meta-lidar/rm-work"
                ],
                "bb-env-passthrough-additions": [
                    "SSTATE_DIR",
                    "DL_DIR"
                ]
            }
        ]
    }
}
